            "body": {
              "mode": "raw",
              "raw": "{\n  \"prompt\": \"A beautiful sunset over mountains, digital art style, vibrant colors\",\n  \"selectedModel\": \"flux-1-srpo\",\n  \"aspectRatio\": \"16:9\",\n  \"numInferenceSteps\": 28,\n  \"guidanceScale\": 4.5,\n  \"style\": \"digital-art\",\n  \"numImages\": 1\n}"
