    {
      "name": "\ud83c\udfa8 AI Generation",
      "item": [
        {
          "name": "Generate Image",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    if (response.generations && response.generations.length > 0) {",
                  "        pm.environment.set('requestId', response.generations[0].requestId);",
                  "        pm.environment.set('aiGenerationId', response.generations[0].aiGenerationId);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
